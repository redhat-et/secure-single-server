#!/usr/bin/env bash
# Read-only checks after boot and dummy/real secret provisioning; makes no model calls.
set -euo pipefail
# shellcheck disable=SC1091
source /usr/share/secure-single-server/bootc/scripts/common
require_root
cd /
expected="${1:?usage: sudo bootc/test-host base|codex|opencode|openclaw}"
[[ "$(selected_harness)" == "${expected}" ]] || die 'unexpected harness selection'
[[ "$(getenforce)" == Enforcing ]] || die 'SELinux is not enforcing'
bootc status --json | jq -e '.status.type == "bootcHost" and .status.booted.image.architecture == "amd64"' >/dev/null
findmnt -T /usr -no OPTIONS | grep -Eq '(^|,)ro(,|$)' || die '/usr is not read-only'
systemctl is-active --quiet secure-single-server.service
as_service systemctl --user is-active --quiet praxis.service
as_openshell systemctl --user is-active --quiet openshell-gateway.service
[[ "$(as_service podman inspect praxis-shared-gateway --format '{{.State.Health.Status}}')" == healthy ]] || die 'Praxis is unhealthy'
curl --fail --silent http://127.0.0.1:8091/healthz >/dev/null
gateway_config=/var/lib/openshell-svc/.config/openshell/gateway.toml
grep -Eq '^[[:space:]]*\[openshell\.gateway\.tls\][[:space:]]*$' "${gateway_config}" \
  || die 'OpenShell gateway TLS is not configured'
grep -Eq '^[[:space:]]*allow_unauthenticated_users[[:space:]]*=[[:space:]]*false[[:space:]]*($|#)' "${gateway_config}" \
  || die 'OpenShell gateway accepts unauthenticated users'
grep -q 'disable_tls' "${gateway_config}" && die 'OpenShell gateway TLS is disabled'
gateway_tls_dir=/var/lib/openshell/tls
authenticated_status="$(curl --silent --show-error --max-time 5 \
  --cacert "${gateway_tls_dir}/ca.crt" \
  --cert "${gateway_tls_dir}/client/tls.crt" \
  --key "${gateway_tls_dir}/client/tls.key" \
  -o /dev/null -w '%{http_code}' https://127.0.0.1:8090/)"
[[ "${authenticated_status}" =~ ^[1-5][0-9]{2}$ ]] || die 'OpenShell gateway TLS handshake failed'
# v0.1.3 accepts certificate-free TLS for sandbox JWT clients. Prove that
# the management RPC still rejects a client with neither identity mechanism.
as_openshell openshell sandbox list >/dev/null
anonymous_home="$(mktemp -d)"
trap 'rm -rf "${anonymous_home}"' EXIT
if HOME="${anonymous_home}" XDG_CONFIG_HOME="${anonymous_home}/config" \
  OPENSHELL_TELEMETRY_ENABLED=false /usr/bin/openshell \
  --gateway-endpoint https://127.0.0.1:8090 --gateway-insecure sandbox list \
  >"${anonymous_home}/result" 2>&1; then
  die 'OpenShell management RPC accepts an unauthenticated client'
fi
grep -q 'missing authorization header' "${anonymous_home}/result" || {
  cat "${anonymous_home}/result" >&2
  die 'unauthenticated check failed without proving an authentication rejection'
}
as_openshell podman image exists "$(harness_image "${expected}")"
ports=(8080 8090 8091)
[[ "$(inference_backend)" != cloud ]] || ports+=(8081)
for port in "${ports[@]}"; do
  listeners="$(ss -H -ltn | awk -v p="${port}" '$4 ~ ":" p "$" {print $4}')"
  [[ "${listeners}" == "127.0.0.1:${port}" ]] || die "unexpected listeners on ${port}: ${listeners}"
done
for user in praxis-svc openshell-svc; do
  [[ "$(stat -c '%a' "/var/lib/${user}")" == 700 ]] || die "${user} home is not private"
  [[ "$(getent passwd "${user}" | cut -d: -f7)" == /usr/sbin/nologin ]] || die "${user} has a login shell"
done
printf 'bootc host: %s ready; SELinux enforcing; root filesystem read-only; gateways loopback-only\n' "${expected}"
