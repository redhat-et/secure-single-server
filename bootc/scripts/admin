#!/usr/bin/env bash
set -euo pipefail
# shellcheck disable=SC1091
source /usr/share/secure-single-server/bootc/scripts/common
# Root's home or a private administrator checkout may be unreadable to service users.
cd /
case "${1:-help}" in
  help|--help|-h)
    cat <<'EOF'
Usage (run as root except help):
  sss-bootc vllm disabled|cpu|gpu|status          Deprecated local Qwen3-8B
  sss-bootc inference cloud|vllm|remote-vllm RFC1918_IP:PORT|status|check
                                                  Select/check Praxis upstream
  sss-bootc status
  sss-bootc secret openai|anthropic VERSION       Read secret from stdin
  sss-bootc activate OPENAI_SECRET ANTHROPIC_SECRET
  sss-bootc openshell ARGS...                    CLI as openshell-svc
  sss-bootc harness create|connect|run ARGS...        Selected harness scripts
Activation uses the memory quota profile. No provider credentials enter the OS image.
EOF
    ;;
  vllm)
    require_root
    [[ "$#" == 2 ]] || die "expected vllm disabled|cpu|gpu|status"
    if [[ "$2" == status ]]; then
      exec "${ROOT}/bootc/scripts/vllm" status
    fi
    "${ROOT}/bootc/scripts/vllm" select "$2"
    ;;
  inference)
    require_root
    subcommand="${2:-}"
    if [[ "$#" == 3 && "${subcommand}" == remote-vllm ]]; then :;
    elif [[ "$#" == 2 && "${subcommand}" != remote-vllm ]]; then :;
    else die 'expected inference cloud|vllm|remote-vllm RFC1918_IP:PORT|status|check'; fi
    case "$2" in
      check) exec "${ROOT}/bootc/scripts/inference-check" ;;
      status)
        backend="$(inference_backend)"
        printf 'Praxis upstream: %s\n' "${backend}"
        if [[ "${backend}" == remote-vllm ]]; then
          endpoint="$(inference_vllm_endpoint)"
          printf 'Remote vLLM endpoint: %s\n' "${endpoint}"
        fi
        exit 0
        ;;
      cloud) ;;
      vllm)
        # shellcheck disable=SC1091
        source "${ROOT}/bootc/scripts/vllm-lib"
        [[ "$(vllm_mode)" != disabled ]] || die 'enable vLLM CPU or GPU mode first'
        ;;
      remote-vllm) validate_vllm_endpoint "$3" ;;
      *) die 'expected inference cloud|vllm|remote-vllm RFC1918_IP:PORT|status|check' ;;
    esac
    exec 9>/run/secure-single-server.lock
    flock 9
    install -d -m 0755 /etc/secure-single-server
    if [[ "$2" == remote-vllm ]]; then
      tmp="$(mktemp /etc/secure-single-server/.vllm-endpoint.XXXXXX)"
      printf '%s\n' "$3" >"${tmp}"
      chmod 0644 "${tmp}"
      mv "${tmp}" /etc/secure-single-server/vllm-endpoint
    fi
    tmp="$(mktemp /etc/secure-single-server/.inference-backend.XXXXXX)"
    printf '%s\n' "$2" >"${tmp}"
    chmod 0644 "${tmp}"
    mv "${tmp}" /etc/secure-single-server/inference-backend
    flock -u 9
    systemctl restart secure-single-server.service
    ;;
  status)
    require_root
    printf 'Harness: %s\n' "$(selected_harness)"
    systemctl status secure-single-server.service --no-pager
    as_openshell systemctl --user status openshell-gateway.service --no-pager
    as_service systemctl --user status praxis.service --no-pager
    ;;
  secret)
    require_root
    [[ "$#" == 3 ]] || die 'secret requires provider and version'
    case "$2" in openai|anthropic) ;; *) die 'expected openai or anthropic' ;; esac
    exec "${ROOT}/scripts/common/secret-set" "$2" "$3"
    ;;
  activate)
    require_root
    [[ "$#" == 3 ]] || die 'activate requires two secret names'
    require_secret "$2"
    require_secret "$3"
    install -d -m 0700 /etc/secure-single-server
    umask 077
    printf '%s %s\n' "$2" "$3" >/etc/secure-single-server/secret-names
    systemctl restart secure-single-server.service
    ;;
  openshell)
    require_root
    shift
    as_openshell openshell "$@"
    ;;
  harness)
    require_root
    harness="$(selected_harness)"
    [[ "${harness}" != base ]] || die 'select a harness bootc image first'
    action="${2:-}"
    case "${action}" in
      create|connect) ;;
      run) [[ "${harness}" == openclaw ]] || die 'harness run supports OpenClaw only' ;;
      *) die 'expected create, connect or run' ;;
    esac
    shift 2
    backend="$(inference_backend)"
    if [[ "${action}" == create && "${backend}" =~ ^(vllm|remote-vllm)$ ]]; then
      [[ "${harness}" == opencode || "${harness}" == openclaw ]] || die 'Praxis vLLM integration supports OpenCode and OpenClaw only'
      for argument in "$@"; do
        case "${argument}" in --provider|--config|--provider=*|--config=*) die 'Praxis vLLM integration owns provider configuration; omit --provider and --config' ;; esac
      done
      config_dir="${ROOT}/configs/vllm/harness"
      [[ "${harness}" != openclaw ]] || config_dir="${ROOT}/configs/vllm/openclaw"
      as_openshell env OPENSHELL_MODEL_ID=Qwen/Qwen3-8B PRAXIS_PORT=8080 \
        "${ROOT}/openshell/harnesses/${harness}/${action}.sh" \
        --config "${config_dir}" "$@"
    else
      as_openshell "${ROOT}/openshell/harnesses/${harness}/${action}.sh" "$@"
    fi
    ;;
  *) die 'unknown command; see sss-bootc help' ;;
esac
