[Unit]
Description=Prepare optional pinned vLLM workload
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/share/secure-single-server/bootc/scripts/vllm reconcile
RemainAfterExit=yes
Restart=on-failure
RestartSec=30s
TimeoutStartSec=30min
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
