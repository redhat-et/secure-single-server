[Unit]
Description=Prepare pinned Praxis and OpenShell workloads
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/share/secure-single-server/bootc/scripts/reconcile
RemainAfterExit=yes
Restart=on-failure
RestartSec=30s
TimeoutStartSec=30min
UMask=0077

[Install]
WantedBy=multi-user.target
