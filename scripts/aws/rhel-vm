#!/usr/bin/env python3
"""Plan/apply one tagged RHEL 9 test VM, or verify it without changing AWS.

Requires AWS CLI v2 and its normal credential chain. Never accepts access keys
as arguments. Creates only a key-pair import, security group, instance and root
disk; no IAM, VPC, DNS, gateway deployment or deletion. Apply is never implicit.
"""
import argparse
import ipaddress
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import uuid

OWNER = "309956199498"
MANAGED = "secure-single-server-test"
READS = {"get-caller-identity", "describe-instance-types", "describe-images", "describe-subnets",
         "describe-route-tables", "describe-instances", "describe-security-groups", "describe-volumes",
         "describe-key-pairs"}
WRITES = {"import-key-pair", "create-security-group", "authorize-security-group-ingress", "run-instances"}


class Aws:
    def __init__(self, region, profile, apply):
        self.region, self.profile, self.apply = region, profile, apply

    def call(self, service, action, **options):
        if action not in READS and (not self.apply or action not in WRITES):
            raise ValueError("AWS operation refused by mode/allowlist: " + action)
        command = ["aws", "--no-cli-pager", "--region", self.region, "--output", "json"]
        if self.profile:
            command += ["--profile", self.profile]
        command += [service, action]
        for key, value in options.items():
            command += ["--" + key.replace("_", "-")]
            if isinstance(value, (dict, list)):
                command += [json.dumps(value)]
            else:
                command += [str(value)]
        result = subprocess.run(command, capture_output=True, text=True)
        if result.returncode:
            # AWS errors may echo request material. Never dump credential chain,
            # debug output or full request arguments into evidence.
            match = re.search(r"\(([A-Za-z0-9_.]+)\)", result.stderr)
            code = match.group(1) if match else "CLI error"
            raise ValueError(f"AWS {action} failed ({code}); check region, credentials and permissions")
        return json.loads(result.stdout or "{}")


def ingress(scenario, cidr):
    network = ipaddress.ip_network(cidr, strict=True)
    if network.version != 4 or network.prefixlen != 32:
        raise ValueError("allowed-cidr must be one explicit IPv4 /32, never a public subnet")
    return [{"IpProtocol": "tcp", "FromPort": port, "ToPort": port,
             "IpRanges": [{"CidrIp": str(network)}]} for port in
            ([22] if scenario == "all-in-one" else [22, 8443])]


def validate_image(image, architecture):
    if (image.get("OwnerId") != OWNER or image.get("Architecture") != architecture
            or image.get("State") != "available" or image.get("RootDeviceType") != "ebs"
            or not re.fullmatch(r"RHEL-9\..*Hourly2-GP3", image.get("Name", ""))):
        raise ValueError("AMI must be an official Red Hat RHEL 9 PAYG GP3 image matching the instance architecture")
    disks = image.get("BlockDeviceMappings", [])
    if (len(disks) != 1 or disks[0].get("DeviceName") != image.get("RootDeviceName")
            or "Ebs" not in disks[0]):
        raise ValueError("AMI must define only one EBS root disk; additional image disks are not supported")


def write_state(output, state):
    json.dump(state, output, indent=2)
    output.write("\n")
    output.flush()
    os.fsync(output.fileno())


def save_state(path, state):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as output:
        write_state(output, state)


def update_state(path, state):
    # Preserve the previous recovery record if writing its successor fails.
    fd, temporary = tempfile.mkstemp(prefix="." + path.name + ".", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as output:
            write_state(output, state)
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


def tags(prefix, scenario):
    return [{"Key": "ManagedBy", "Value": MANAGED}, {"Key": "ResourcePrefix", "Value": prefix},
            {"Key": "Scenario", "Value": scenario}, {"Key": "Name", "Value": prefix}]


def filters(**values):
    return [{"Name": key, "Values": [value]} for key, value in values.items()]


def check_identity(aws, account):
    identity = aws.call("sts", "get-caller-identity")
    if identity["Account"] != account or identity["Arn"].endswith(":root"):
        raise ValueError("wrong AWS account or root-account credentials; no changes made")
    return identity


def plan(aws, args):
    identity = check_identity(aws, args.account_id)
    instance_type = args.instance_type or ("m7g.2xlarge" if args.arch == "arm64" else "m7i.2xlarge")
    machine = aws.call("ec2", "describe-instance-types", instance_types=[instance_type])["InstanceTypes"][0]
    architecture = "arm64" if args.arch == "arm64" else "x86_64"
    if machine["MemoryInfo"]["SizeInMiB"] < 32768 or architecture not in machine["ProcessorInfo"]["SupportedArchitectures"]:
        raise ValueError("instance must have at least 32 GiB RAM and match --arch")
    image_filters = filters(name=f"RHEL-9.*_HVM-*-{architecture}-*-Hourly2-GP3",
                            architecture=architecture, state="available")
    images = aws.call("ec2", "describe-images", owners=[OWNER], filters=image_filters)["Images"]
    if args.ami_id:
        images = [image for image in images if image["ImageId"] == args.ami_id]
    if not images:
        raise ValueError("no matching official RHEL 9 image; inspect available AMIs in this region")
    image = max(images, key=lambda item: item["CreationDate"])
    validate_image(image, architecture)
    subnet = aws.call("ec2", "describe-subnets", subnet_ids=[args.subnet_id])["Subnets"][0]
    if subnet["State"] != "available":
        raise ValueError("subnet is not available")
    tables = aws.call("ec2", "describe-route-tables",
                      filters=filters(**{"association.subnet-id": args.subnet_id}))["RouteTables"]
    if not tables:
        tables = aws.call("ec2", "describe-route-tables", filters=filters(
            **{"vpc-id": subnet["VpcId"], "association.main": "true"}))["RouteTables"]
    if not any(route.get("DestinationCidrBlock") == "0.0.0.0/0"
               and route.get("GatewayId", "").startswith("igw-") and route.get("State") == "active"
               for table in tables for route in table["Routes"]):
        raise ValueError("selected subnet must have an active IPv4 internet-gateway route")
    active = aws.call("ec2", "describe-instances", filters=[
        {"Name": "tag:ResourcePrefix", "Values": [args.prefix]},
        {"Name": "instance-state-name", "Values": ["pending", "running", "stopping", "stopped"]}])
    if any(row["Instances"] for row in active["Reservations"]):
        raise ValueError("an active VM already uses this prefix; verify it instead of launching again")
    groups = aws.call("ec2", "describe-security-groups", filters=filters(
        **{"vpc-id": subnet["VpcId"], "group-name": args.prefix}))["SecurityGroups"]
    if groups:
        raise ValueError("security-group name already exists; inspect partial resources, then use a fresh prefix")
    keys = aws.call("ec2", "describe-key-pairs", filters=filters(**{"key-name": args.prefix}))["KeyPairs"]
    if keys:
        raise ValueError("SSH key-pair name already exists; inspect it and choose a fresh resource prefix")
    key = args.public_key.read_text()
    if "PRIVATE KEY" in key or len(key.strip().splitlines()) != 1:
        raise ValueError("provide one OpenSSH public key, never the private key")
    subprocess.run(["ssh-keygen", "-lf", str(args.public_key)], check=True, capture_output=True)
    if key.split()[0] not in ("ssh-ed25519", "ssh-rsa"):
        raise ValueError("EC2 key import supports an Ed25519 or RSA public key")
    rules = ingress(args.scenario, args.allowed_cidr)
    return {"AccountId": identity["Account"], "PrincipalArn": identity["Arn"], "Region": args.region,
            "Prefix": args.prefix, "Scenario": args.scenario, "InstanceType": instance_type,
            "Architecture": architecture, "ImageId": image["ImageId"], "ImageName": image["Name"],
            "RootDeviceName": image["RootDeviceName"], "SubnetId": args.subnet_id, "VpcId": subnet["VpcId"],
            "Ingress": rules, "VolumeGiB": args.volume_gib, "StateFile": str(args.state_file)}


def apply_plan(aws, args, proposal):
    state = {**proposal, "ClientToken": str(uuid.uuid4()), "ApplyStatus": "started"}
    save_state(args.state_file, state)
    print("Recovery journal:", args.state_file, flush=True)
    owned = tags(args.prefix, args.scenario)
    group = aws.call("ec2", "create-security-group", group_name=args.prefix, vpc_id=proposal["VpcId"],
                     description="Disposable secure-single-server VM; explicit administrator IPv4 only",
                     tag_specifications=[{"ResourceType": "security-group", "Tags": owned}])["GroupId"]
    print("Created security group:", group, flush=True)
    state.update(SecurityGroupId=group, ApplyStatus="security-group-created")
    update_state(args.state_file, state)
    aws.call("ec2", "authorize-security-group-ingress", group_id=group, ip_permissions=proposal["Ingress"])
    aws.call("ec2", "import-key-pair", key_name=args.prefix,
             public_key_material="fileb://" + str(args.public_key.resolve()),
             tag_specifications=[{"ResourceType": "key-pair", "Tags": owned}])
    state.update(KeyPairName=args.prefix, ApplyStatus="launch-requested")
    update_state(args.state_file, state)
    # The private SSH key and AWS credentials never leave the workstation.
    result = aws.call("ec2", "run-instances", image_id=proposal["ImageId"],
        instance_type=proposal["InstanceType"], count=1, client_token=state["ClientToken"], key_name=args.prefix,
        network_interfaces=[{"DeviceIndex": 0, "SubnetId": args.subnet_id,
                             "AssociatePublicIpAddress": True, "DeleteOnTermination": True, "Groups": [group]}],
        metadata_options={"HttpTokens": "required", "HttpEndpoint": "enabled", "HttpPutResponseHopLimit": 1},
        block_device_mappings=[{"DeviceName": proposal["RootDeviceName"], "Ebs": {
            "Encrypted": True, "VolumeSize": args.volume_gib, "VolumeType": "gp3", "DeleteOnTermination": True}}],
        tag_specifications=[{"ResourceType": kind, "Tags": owned} for kind in ["instance", "volume"]])
    instance_id = result["Instances"][0]["InstanceId"]
    print("Launched instance:", instance_id, flush=True)
    state.update(InstanceId=instance_id, ApplyStatus="complete")
    update_state(args.state_file, state)
    print("State saved. Run verify after boot. On any failure inspect tagged resources; none are deleted automatically.")


def verify(aws, args):
    check_identity(aws, args.account_id)
    state = json.loads(args.state_file.read_text())
    if state["AccountId"] != args.account_id or state["Region"] != args.region:
        raise ValueError("state file account/region does not match the explicitly selected target")
    if "InstanceId" not in state:
        raise ValueError("incomplete apply journal; inspect resource-prefix tags and ClientToken before retrying")
    instance = aws.call("ec2", "describe-instances", instance_ids=[state["InstanceId"]])["Reservations"][0]["Instances"][0]
    actual_tags = {item["Key"]: item["Value"] for item in instance.get("Tags", [])}
    if any(actual_tags.get(item["Key"]) != item["Value"] for item in tags(state["Prefix"], state["Scenario"])):
        raise ValueError("instance ownership/scenario tags do not match")
    if instance["ImageId"] != state["ImageId"] or instance["InstanceType"] != state["InstanceType"]:
        raise ValueError("instance image/type differs from the recorded plan")
    image = aws.call("ec2", "describe-images", image_ids=[instance["ImageId"]])["Images"][0]
    validate_image(image, state["Architecture"])
    metadata = instance["MetadataOptions"]
    if (metadata["HttpTokens"] != "required" or metadata["HttpPutResponseHopLimit"] != 1
            or metadata["HttpEndpoint"] != "enabled" or instance.get("IamInstanceProfile")):
        raise ValueError("unexpected metadata policy or IAM instance profile")
    if [group["GroupId"] for group in instance["SecurityGroups"]] != [state["SecurityGroupId"]]:
        raise ValueError("unexpected attached security groups")
    group = aws.call("ec2", "describe-security-groups", group_ids=[state["SecurityGroupId"]])["SecurityGroups"][0]
    group_tags = {item["Key"]: item["Value"] for item in group.get("Tags", [])}
    if any(group_tags.get(item["Key"]) != item["Value"] for item in tags(state["Prefix"], state["Scenario"])):
        raise ValueError("security-group ownership/scenario tags do not match")
    normalized = []
    for permission in group["IpPermissions"]:
        if permission.get("Ipv6Ranges") or permission.get("UserIdGroupPairs") or permission.get("PrefixListIds"):
            raise ValueError("unexpected non-IPv4 ingress")
        normalized.append({key: permission[key] for key in ["IpProtocol", "FromPort", "ToPort", "IpRanges"]})
    if sorted(normalized, key=lambda rule: rule["FromPort"]) != state["Ingress"]:
        raise ValueError("security-group ingress differs from the recorded plan")
    interfaces = instance.get("NetworkInterfaces", [])
    if len(interfaces) != 1 or not interfaces[0].get("Attachment", {}).get("DeleteOnTermination"):
        raise ValueError("expected one network interface with deletion on termination")
    if len(instance["BlockDeviceMappings"]) != 1:
        raise ValueError("unexpected extra disks; termination-only cleanup is no longer assured")
    root = next(item for item in instance["BlockDeviceMappings"] if item["DeviceName"] == state["RootDeviceName"])
    volume = aws.call("ec2", "describe-volumes", volume_ids=[root["Ebs"]["VolumeId"]])["Volumes"][0]
    if not volume["Encrypted"] or not root["Ebs"]["DeleteOnTermination"] or volume["Size"] < state["VolumeGiB"]:
        raise ValueError("unexpected root-disk encryption, size or deletion policy")
    print(json.dumps({"InstanceId": instance["InstanceId"], "State": instance["State"]["Name"],
                      "PublicIpAddress": instance.get("PublicIpAddress"), "Scenario": state["Scenario"],
                      "Result": "AWS configuration verified; SSH, host firewall and gateway tests remain separate"}, indent=2))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("mode", choices=["plan", "apply", "verify"], nargs="?", default="plan")
    parser.add_argument("--region", required=True)
    parser.add_argument("--account-id", required=True)
    parser.add_argument("--profile")
    parser.add_argument("--state-file", type=Path, required=True)
    parser.add_argument("--scenario", choices=["all-in-one", "remote-gateway"])
    parser.add_argument("--prefix")
    parser.add_argument("--subnet-id")
    parser.add_argument("--public-key", type=Path)
    parser.add_argument("--allowed-cidr")
    parser.add_argument("--arch", choices=["amd64", "arm64"], default="amd64")
    parser.add_argument("--instance-type")
    parser.add_argument("--ami-id")
    parser.add_argument("--volume-gib", type=int, default=50)
    args = parser.parse_args()
    if not re.fullmatch(r"\d{12}", args.account_id):
        raise ValueError("account-id must be the expected 12-digit account, obtained independently")
    access, secret = os.environ.get("AWS_ACCESS_KEY_ID"), os.environ.get("AWS_SECRET_ACCESS_KEY")
    if bool(access) != bool(secret):
        raise ValueError("both AWS access-key variables must be set, or both unset")
    if access and (args.profile or os.environ.get("AWS_PROFILE") or os.environ.get("AWS_DEFAULT_PROFILE")):
        raise ValueError("do not mix exported AWS keys and a profile")
    aws = Aws(args.region, args.profile, False)
    if args.mode == "verify":
        verify(aws, args)
        return
    if not all([args.scenario, args.prefix, args.subnet_id, args.public_key, args.allowed_cidr]):
        raise ValueError("plan/apply need --scenario, --prefix, --subnet-id, --public-key and --allowed-cidr")
    if not re.fullmatch(r"[a-z][a-z0-9-]{2,39}", args.prefix) or args.volume_gib < 50:
        raise ValueError("prefix must be 3-40 lowercase letters/digits/hyphens; disk must be at least 50 GiB")
    if args.state_file.exists() or args.state_file.is_symlink():
        raise ValueError("state file already exists; verify it or use a new path")
    proposal = plan(aws, args)
    print(json.dumps(proposal, indent=2))
    print("Plan: one on-demand VM, encrypted root disk, imported PUBLIC key and security group."
          " Default security-group IPv4 egress is unrestricted. No IAM/SSM or application install.")
    if args.mode == "plan":
        print("Read-only plan complete: no AWS resource or local state file was changed.")
        return
    confirmation = f"launch {args.account_id} {args.region} {args.prefix}"
    if input("Billable resources. Type exactly '" + confirmation + "': ") != confirmation:
        raise ValueError("confirmation did not match; no changes made")
    aws.apply = True
    apply_plan(aws, args, proposal)


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, KeyError, IndexError, subprocess.CalledProcessError) as error:
        print("error: " + str(error), file=sys.stderr)
        print("No automatic cleanup. If apply started, inspect the printed IDs and resource-prefix tags.", file=sys.stderr)
        sys.exit(1)
