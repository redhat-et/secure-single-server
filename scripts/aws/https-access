#!/usr/bin/env python3
"""Add workstation-only HTTPS to an existing test VM and update its launch journal."""
import argparse
import copy
import importlib.machinery
import importlib.util
import ipaddress
import json
from pathlib import Path
import sys

loader = importlib.machinery.SourceFileLoader('rhel_vm', str(Path(__file__).with_name('rhel-vm')))
spec = importlib.util.spec_from_loader(loader.name, loader)
vm = importlib.util.module_from_spec(spec)
loader.exec_module(vm)


def proposal(state, cidr):
    network = ipaddress.ip_network(cidr, strict=True)
    if network.version != 4 or network.prefixlen != 32 or not network.is_global:
        raise ValueError('allowed-cidr must be one public IPv4 /32')
    result = copy.deepcopy(state)
    rule = {'IpProtocol': 'tcp', 'FromPort': 8443, 'ToPort': 8443,
            'IpRanges': [{'CidrIp': str(network)}]}
    existing = [r for r in result['Ingress'] if r.get('FromPort') == 8443]
    if existing and existing != [rule]:
        raise ValueError('journal already has different HTTPS access; review it before changing access')
    if not existing:
        result['Ingress'].append(rule)
        result['Ingress'].sort(key=lambda r: r['FromPort'])
    result['HttpsAccess'] = 'restricted'
    return result, rule


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--state-file', type=Path, required=True)
    parser.add_argument('--account-id', required=True)
    parser.add_argument('--region', required=True)
    parser.add_argument('--profile')
    parser.add_argument('--allowed-cidr', required=True)
    parser.add_argument('--apply', action='store_true')
    args = parser.parse_args()
    aws = vm.Aws(args.region, args.profile, False)
    vm.check_identity(aws, args.account_id)
    state = vm.launch_state(args.state_file, args)
    if state['Scenario'] not in ('all-in-one', 'remote-gateway'):
        raise ValueError('HTTPS gateway access requires an all-in-one or remote-gateway VM')
    vm.described_instance(aws, state, state['Scenario'])
    desired, rule = proposal(state, args.allowed_cidr)

    def inspect():
        groups = aws.call('ec2', 'describe-security-groups', group_ids=[state['SecurityGroupId']])['SecurityGroups']
        if len(groups) != 1:
            raise ValueError('security group not found')
        group = groups[0]
        vm.check_owned(group, state)
        try:
            vm.check_ingress(group, desired)
            return True
        except ValueError:
            vm.check_ingress(group, state)
            return False

    exists = inspect()
    print(json.dumps({'InstanceId': state['InstanceId'], 'SecurityGroupId': state['SecurityGroupId'],
                      'HTTPS': rule, 'AlreadyPresent': exists}, indent=2))
    if not args.apply:
        print('Read-only plan. Repeat with --apply to authorize and journal this rule.')
        return
    confirmation = f"https {args.account_id} {args.region} {state['SecurityGroupId']} {args.allowed_cidr}"
    if input(f"Type exactly '{confirmation}': ") != confirmation:
        raise ValueError('confirmation did not match; nothing changed')
    if not inspect():
        aws.apply = True
        aws.call('ec2', 'authorize-security-group-ingress', group_id=state['SecurityGroupId'],
                 ip_permissions=[rule])
    vm.save_state(args.state_file, desired)
    print('HTTPS access and launch journal updated; SSH rules unchanged.')


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError) as error:
        sys.exit(str(error))
