#!/usr/bin/env python3
"""Administer non-expiring caller JWTs and their live manual_jwt registry.

Run on the gateway host after SSH. No network access or credential values printed.
A stable subject retains its spending identity across rotation and revocation.
"""
import argparse
import base64
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import time
import uuid

ISSUER = 'https://secure-single-server.local'
AUDIENCE = 'praxis-gateway'


def private(path):
    if path.is_symlink() or not path.is_file() or path.stat().st_mode & 0o077:
        raise ValueError('signing key must be a private regular file (0600 or 0400)')


def encode(data):
    return base64.urlsafe_b64encode(data).rstrip(b'=')


def load(path):
    if path.is_symlink() or not path.is_file():
        raise ValueError('registry must be an existing regular file; use init first')
    value = json.loads(path.read_text())
    if set(value) != {'version', 'users'} or value['version'] != 1 or not isinstance(value['users'], dict):
        raise ValueError('invalid registry schema')
    for subject, entry in value['users'].items():
        if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.@-]{0,127}', subject) or set(entry) != {'digest', 'active'}:
            raise ValueError('invalid registry entry')
        if not isinstance(entry['active'], bool) or not re.fullmatch(r'[0-9a-f]{64}', entry['digest']):
            raise ValueError('invalid registry credential')
    return value


def replace(path, value):
    original = path.stat()
    descriptor, name = tempfile.mkstemp(prefix='.registry-', dir=path.parent)
    try:
        with os.fdopen(descriptor, 'w') as output:
            if os.geteuid() == 0:
                os.fchown(output.fileno(), original.st_uid, original.st_gid)
            os.fchmod(output.fileno(), original.st_mode & 0o777)
            json.dump(value, output, indent=2, sort_keys=True)
            output.write('\n')
            output.flush()
            os.fsync(output.fileno())
        os.replace(name, path)
        directory = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def issue(key, subject, output):
    private(key)
    claims = {'iss': ISSUER, 'aud': AUDIENCE, 'sub': subject,
              'iat': int(time.time()), 'jti': str(uuid.uuid4())}
    unsigned = encode(b'{"alg":"RS256","typ":"JWT"}') + b'.' + encode(json.dumps(claims).encode())
    signature = subprocess.run(['openssl', 'dgst', '-sha256', '-sign', str(key)],
        input=unsigned, capture_output=True, check=True).stdout
    token = unsigned + b'.' + encode(signature)
    with open(output, 'xb') as destination:
        destination.write(token + b'\n')
        destination.flush()
        os.fsync(destination.fileno())
    return {'active': True, 'digest': hashlib.sha256(token).hexdigest()}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=['init', 'issue', 'rotate', 'revoke', 'list'])
    parser.add_argument('--registry', type=Path, default=Path('/etc/praxis-pricetag/gateway/users.json'))
    parser.add_argument('--key', type=Path, default=Path('/root/pricetag-admin/issuer/private.pem'))
    parser.add_argument('--subject')
    parser.add_argument('--output', type=Path)
    args = parser.parse_args()
    os.umask(0o077)
    if args.command not in ('init', 'list') and (
            not args.subject or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.@-]{0,127}', args.subject)):
        parser.error('subject must be 1–128 letters, digits, dot, underscore, @ or hyphen')
    if args.command in ('issue', 'rotate') and not args.output:
        parser.error('issue and rotate require a new --output file')
    descriptor = os.open(str(args.registry) + '.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(descriptor, 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if args.command == 'init':
            with open(args.registry, 'x') as destination:
                json.dump({'version': 1, 'users': {}}, destination)
            print('Created empty credential registry.')
            return
        registry = load(args.registry)
        users = registry['users']
        if args.command == 'list':
            for subject, entry in sorted(users.items()):
                print(subject + ': ' + ('active' if entry['active'] else 'revoked'))
            return
        if args.command == 'issue' and args.subject in users:
            parser.error('subject already exists; use rotate to replace or reactivate its credential')
        if args.command in ('rotate', 'revoke') and args.subject not in users:
            parser.error('unknown subject; use issue to provision its first credential')
        if args.command == 'revoke':
            users[args.subject]['active'] = False
        else:
            users[args.subject] = issue(args.key, args.subject, args.output)
        replace(args.registry, registry)
    print(f'{args.command}: {args.subject}; spending identity and history unchanged.')
    if args.output:
        print(f'JWT saved privately to {args.output}; no automatic expiry.')
    print('Existing dashboard cookies remain valid until logout or their seven-day expiry.')


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        raise SystemExit('credential operation failed: ' + (
            'OpenSSL signing failed' if isinstance(error, subprocess.CalledProcessError) else str(error))) from None
