def normalize_url(value, api):
    from provider_config import endpoint
    value = value.strip()
    if '://' not in value:
        value = 'https://' + value
    endpoint(value)
    origin = 'https://' + urllib.parse.urlsplit(value).netloc
    return origin + ('/v1' if api == 'openai' else '')


def pricetag_urls(value):
    """Derive the documented route pair; generic hosts serve both API paths."""
    origin = normalize_url(value, 'anthropic')
    parsed = urllib.parse.urlsplit(origin)
    authority = parsed.netloc
    messages, openai = authority, authority
    if authority.lower().startswith('ai-gateway-unified-'):
        openai = 'ai-gateway-openai-' + authority[len('ai-gateway-unified-'):]
    elif authority.lower().startswith('ai-gateway-openai-'):
        messages = 'ai-gateway-unified-' + authority[len('ai-gateway-openai-'):]
    return {'anthropic': normalize_url('https://' + messages, 'anthropic'),
            'openai': normalize_url('https://' + openai, 'openai')}


class ModelDiscoveryUnavailable(ValueError):
    """The initial catalog URL returned an unavailable/unsupported status."""


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise ValueError('Model discovery refused a redirect; use the final HTTPS provider origin')


def debug_response(api, url, status, headers, elapsed, key):
    if not DEBUG:
        return
    def safe(value):
        text = str(value or '').replace(key, '[redacted]')
        return ''.join(c for c in text if 32 <= ord(c) < 127)[:200]
    print('DEBUG response:', json.dumps({'api': api, 'url': url, 'status': status,
        'elapsed_seconds': round(elapsed, 3),
        'content_type': safe(headers.get('Content-Type')),
        'request_id': safe(headers.get('x-request-id'))}, sort_keys=True))


def discover_models(url, api, key):
    from provider_config import endpoint
    endpoint(url)
    base = url.rstrip('/')
    if not base.endswith('/v1'):
        base += '/v1'
    headers = {'Accept': 'application/json'}
    bearer = CATALOG_AUTH == 'bearer' or (CATALOG_AUTH == 'native' and
        (api == 'openai' or MESSAGES_AUTH == 'bearer'))
    if bearer:
        headers['Authorization'] = 'Bearer ' + key
    else:
        headers['x-api-key'] = key
    if api == 'anthropic' or not bearer:
        headers['anthropic-version'] = '2023-06-01'
    # Never forward a credential through redirects or inherited proxy settings.
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())
    models, cursor = {}, ''
    for _ in range(20):
        target = base + '/models'
        if cursor:
            target += '?' + urllib.parse.urlencode({'after_id': cursor})
        if DEBUG:
            auth = 'Authorization: Bearer [redacted]' if bearer else 'x-api-key: [redacted]'
            print(f'DEBUG request: GET {target}; api={api}; auth={auth}; TLS verification=on; redirects=off')
        started = time.monotonic()
        try:
            with opener.open(urllib.request.Request(target, headers=headers), timeout=20) as response:
                raw = response.read(1048577)
                debug_response(api, target, getattr(response, 'status', 200),
                               getattr(response, 'headers', {}), time.monotonic() - started, key)
            if len(raw) > 1048576:
                raise ValueError('Model catalog is too large')
            data = json.loads(raw)
        except urllib.error.HTTPError as error:
            status = error.code
            debug_response(api, target, status, error.headers or {}, time.monotonic() - started, key)
            error.close()
            if not cursor and status in (404, 405, 501):
                raise ModelDiscoveryUnavailable(f'{api} model discovery returned HTTP {status} at {target}') from None
            raise ValueError(f'{api} model discovery returned HTTP {status} at {target}; check endpoint/key permissions') from None
        except (urllib.error.URLError, OSError) as error:
            if DEBUG:
                reason = getattr(error, 'reason', error)
                print('DEBUG connection failure:', type(reason).__name__)
            raise ValueError(f'{api} discovery failed at {target}; check HTTPS certificate, endpoint and connectivity') from None
        except (json.JSONDecodeError, UnicodeError):
            raise ValueError('Model discovery did not return valid JSON') from None
        if not isinstance(data, dict) or not isinstance(data.get('data'), list):
            raise ValueError('Expected a /v1/models response with a data list')
        if DEBUG:
            print(f'DEBUG catalog: api={api}; page_entries={len(data["data"])}; has_more={bool(data.get("has_more"))}')
        for item in data['data']:
            model = item.get('id') if isinstance(item, dict) else None
            if (isinstance(model, str) and key not in model and
                    re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._:/-]{0,179}', model)):
                models[model] = item
        if not data.get('has_more'):
            return [models[name] for name in sorted(models)]
        following = data.get('last_id')
        if not isinstance(following, str) or following not in models or following == cursor:
            raise ValueError('Invalid model pagination cursor')
        cursor = following
    raise ValueError('Model catalog exceeds the pagination limit')


def messages_auth(config, scheme):
    """Set the upstream credential's header, independently of model selection."""
    found = []
    for chain in config['filter_chains']:
        for item in chain['filters']:
            if item['filter'] == 'credential_injection':
                found += [c for c in item['clusters'] if c['name'] == 'pricetag-anthropic']
    if len(found) != 1:
        raise ValueError('Expected one PriceTag Messages credential injection')
    found[0].update(header='Authorization' if scheme == 'bearer' else 'x-api-key',
                    header_prefix='Bearer ' if scheme == 'bearer' else '')


def diagnose_catalog_auth(urls, key):
    """Read-only catalog probes; never save the supplied credential."""
    global CATALOG_AUTH
    original, seen, accepted = CATALOG_AUTH, set(), False
    try:
        for api, url in urls.items():
            target = normalize_url(url, 'openai')
            if target in seen:
                continue
            seen.add(target)
            print('Catalog:', target + '/models')
            for scheme in ('x-api-key', 'bearer'):
                CATALOG_AUTH = scheme
                try:
                    rows = discover_models(url, api, key)
                except ValueError as error:
                    print(scheme + ': ' + str(error).replace(key, '[redacted]'))
                else:
                    print(f'{scheme}: accepted; {len(rows)} advertised models')
                    accepted = True
    finally:
        CATALOG_AUTH = original
    print('Diagnostic only: no key saved and no provider configuration changed.')
    print('Catalog success does not verify the inference API or model entitlement.')
    if not accepted:
        raise ValueError('Neither catalog header succeeded; verify the key issuer, endpoint and credential permissions')


def diagnose_inference(urls, key, selected):
    """Try a tiny text request with each header, without saving provider inputs."""
    api, model = selected
    if api not in urls:
        raise ValueError('Diagnostic API has no configured endpoint')
    base = normalize_url(urls[api], 'openai')
    if api == 'anthropic':
        target = base + '/messages'
        body = {'model': model, 'max_tokens': 16,
                'messages': [{'role': 'user', 'content': 'Reply OK.'}]}
    else:
        target = base + '/responses'
        body = {'model': model, 'max_output_tokens': 16, 'input': 'Reply OK.', 'store': False}
    print('Inference diagnostic:', target, 'model=' + model, 'maximum output=16 tokens')
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())
    accepted = False
    for scheme in (('x-api-key', 'bearer') if api == 'anthropic' else ('bearer', 'x-api-key')):
        headers = {'Content-Type': 'application/json', 'Accept': 'application/json'}
        headers['Authorization' if scheme == 'bearer' else 'x-api-key'] = (
            'Bearer ' + key if scheme == 'bearer' else key)
        if api == 'anthropic':
            headers['anthropic-version'] = '2023-06-01'
        request = urllib.request.Request(target, data=json.dumps(body).encode(), headers=headers)
        try:
            response = opener.open(request, timeout=30)
        except urllib.error.HTTPError as error:
            status = error.code
            error.close()
            print(f'{scheme}: HTTP {status}')
            # Retry the other header only for authentication/authorization errors.
            if status not in (401, 403):
                break
        except (urllib.error.URLError, OSError):
            print(scheme + ': connection/TLS failure or timeout; no response body shown')
            break
        else:
            try:
                accepted = response.status == 200 and 'application/json' in response.headers.get('Content-Type', '')
                print(f'{scheme}: HTTP {response.status}; JSON response={accepted}')
                response.read(16384)
            finally:
                response.close()
            break
    print('Diagnostic only: no key saved and no provider configuration changed. Inference may incur usage.')
    if not accepted:
        raise ValueError('Inference probe did not succeed; no credential or model access assumed')


def check_host(allow_active=False):
    if os.geteuid() != 0:
        raise ValueError('Run with sudo on the gateway host')
    if DEPLOY.exists() or Path('/root/pricetag-admin').exists():
        if not allow_active or not (DEPLOY / 'bootstrap.done').is_file():
            raise ValueError('Already prepared: only openai/pricetag --replace supports active deployment updates')
    if STATE.is_symlink() or (STATE.exists() and (
            not STATE.is_dir() or STATE.stat().st_uid != 0 or STATE.stat().st_mode & 0o077)):
        raise ValueError('Provider inputs must be a root-owned private directory')


def service(*args, **kwargs):
    uid = pwd.getpwnam('praxis-svc').pw_uid
    return subprocess.run(['sudo', '-u', 'praxis-svc', 'env',
        'XDG_RUNTIME_DIR=/run/user/' + str(uid),
        'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/' + str(uid) + '/bus',
        *args], cwd='/tmp', capture_output=True, **kwargs)


def prompt(label, default=''):
    value = input(label + (f' [{default}]' if default else '') + ': ').strip()
    value = value or default
    if not value:
        raise ValueError('A value is required')
    return value


def provider_settings(name, api, url, key, urls=None):
    from unified_config import validate
    urls = {dialect: normalize_url(address, dialect) for dialect, address in (urls or {api: url}).items()}
    active_urls = {}
    selected, prices = {}, {}
    unverified = []
    unverified_models = []
    for dialect, address in urls.items():
        try:
            discovered = discover_models(address, dialect, key)
        except ModelDiscoveryUnavailable as error:
            if name != 'pricetag' or not ALLOW_UNVERIFIED_MODELS:
                raise ValueError(str(error) + '; verify the URL. For a known PriceTag endpoint without '
                                 'discovery, opt in with --allow-unverified-models') from None
            print('WARNING:', str(error))
            print('UNVERIFIED models: using configured presets; credentials, model access and served limits are not verified.')
            discovered = [{'id': model} for model, _, _ in PRESETS[dialect]]
            unverified.append(dialect)
        available = {m['id']: m for m in discovered}
        enabled = 0
        for model, context, output in PRESETS[dialect]:
            if model not in available:
                if name == 'pricetag' and (dialect, model) in PINNED_MODELS:
                    print('UNVERIFIED pin; not advertised by this catalog:', model)
                    unverified_models.append(model)
                else:
                    print('Not advertised; skipped:', model)
                    continue
            metadata = available.get(model, {}).get('praxis', {})
            if isinstance(metadata, dict):
                advertised_context, advertised_output = metadata.get('context'), metadata.get('output')
                if (type(advertised_context) is int and type(advertised_output) is int
                        and 0 < advertised_output < advertised_context <= 2000000):
                    context, output = min(context, advertised_context), min(output, advertised_output)
            alias = name + '/' + model
            selected[alias] = {'id': alias, 'provider': name, 'model': model,
                               'apis': [dialect], 'context': context, 'output': output}
            prices[alias] = model
            enabled += 1
            print(f'Enabled {alias}: {dialect}, context={context}, output={output}')
        if enabled:
            active_urls[dialect] = address
        else:
            print('No matching presets; disabled API:', dialect)
            print('Advertised models:', ', '.join(sorted(available)[:30]) or '(empty catalog)')
    if not selected:
        raise ValueError('No preset models available on either endpoint; no secret saved')
    models = validate(list(selected.values()))
    version = 1
    while service('podman', 'secret', 'exists', f'praxis-{name}-api-key-v{version}').returncode == 0:
        version += 1
    return {'models': models, 'prices': prices, 'urls': active_urls, 'unverified_apis': unverified,
            'unverified_models': unverified_models, 'messages_auth': MESSAGES_AUTH,
            'model': models[0], 'api': api, 'url': url, 'price': prices[models[0]['id']],
            'secret': f'praxis-{name}-api-key-v{version}'}


def replace_endpoints(config, urls, name='pricetag'):
    from provider_config import endpoint
    result = copy.deepcopy(config)
    for api, url in urls.items():
        found = []
        for chain in result['filter_chains']:
            for item in chain['filters']:
                if item['filter'] == 'load_balancer':
                    found += [c for c in item['clusters'] if c['name'] == (api if name == 'openai' else name + '-' + api)]
        if len(found) != 1:
            raise ValueError('Expected one existing ' + name + ' cluster for ' + api)
        replacement = endpoint(url)
        found[0]['endpoints'] = replacement['endpoints']
        # Preserve provider/accounting metadata and existing transport settings.
        for field in ('http', 'tls'):
            found[0].setdefault(field, {}).update(replacement[field])
    return result


def check_replacement_models(models, settings):
    available = {m['id']: m for m in settings['models']}
    if not models:
        raise ValueError('No existing models for PriceTag')
    installed = {(api, m['model']) for m in models for api in m['apis']}
    if PINNED_MODELS - installed:
        raise ValueError('Endpoint/key replacement does not add models; new pins require a separate '
                         'catalog, route and pricing update. No active configuration changed')
    for model in models:
        candidate = available.get(model['id'])
        if (candidate is None or candidate['model'] != model['model']
                or not set(model['apis']) <= set(candidate['apis'])
                or candidate['context'] < model['context'] or candidate['output'] < model['output']):
            raise ValueError('Replacement does not support existing model/limits: ' + model['id']
                             + '; no active configuration changed')


def refresh_model_files(settings):
    """Rebuild native routes while retaining the deployed authentication boundary."""
    import yaml
    from provider_config import render
    from unified_config import validate
    sys.path.insert(0, str(ROOT / 'scripts/pricetag'))
    from gateway import render as gateway
    old_models = validate(json.loads((DEPLOY / 'models.json').read_text()))
    models = validate([m for m in old_models if m['provider'] != 'pricetag'] + settings['models'])
    if any(m['provider'] != 'pricetag' for m in settings['models']):
        raise ValueError('Refresh only accepts PriceTag models')
    providers = json.loads((STATE / 'providers.json').read_text())
    current = json.loads((DEPLOY / 'gateway/gateway.json').read_text())
    # Refuse to overwrite native-chain edits made outside the provider helper.
    expected = {c['name']: c for c in gateway(providers, old_models)['filter_chains']}
    for chain in current['filter_chains']:
        if chain['name'] in ('openai', 'anthropic') and chain != expected[chain['name']]:
            raise ValueError('Native gateway settings differ from saved inputs; review them before refreshing models')
    fresh = render(yaml.safe_load((ROOT / 'configs/all-in-one/shared-gateway.yaml').read_text()),
        vllm=False, openai=False, anthropic=False,
        custom={'pricetag': {api + '_url': url for api, url in settings['urls'].items()}})
    fresh = {c['name']: c for c in fresh['filter_chains']}
    for chain in providers['filter_chains']:
        for kind in ('load_balancer', 'credential_injection'):
            additions = [c for f in fresh[chain['name']]['filters'] if f['filter'] == kind
                         for c in f['clusters']]
            existing = [f for f in chain['filters'] if f['filter'] == kind]
            if len(existing) > 1:
                raise ValueError('Ambiguous native provider filters')
            if existing:
                existing[0]['clusters'] = [c for c in existing[0]['clusters']
                    if not c['name'].startswith('pricetag-')] + additions
            elif additions:
                chain['filters'].append({'filter': kind, 'clusters': additions})
    if 'anthropic' in settings['urls']:
        messages_auth(providers, settings.get('messages_auth', 'x-api-key'))
    generated = {c['name']: c for c in gateway(providers, models)['filter_chains']}
    updated = copy.deepcopy(current)
    for index, chain in enumerate(updated['filter_chains']):
        if chain['name'] in ('openai', 'anthropic'):
            updated['filter_chains'][index] = generated[chain['name']]
        elif chain['name'] == 'authenticated':
            def catalogs(filters):
                return [f for f in filters if f['filter'] == 'static_response' and
                    f.get('conditions') == [{'when': {'path': '/v1/models', 'methods': ['GET']}}]]
            entries = catalogs(chain['filters'])
            if len(entries) != 1:
                raise ValueError('Expected one authenticated gateway catalog')
            entries[0]['body'] = catalogs(generated['authenticated']['filters'])[0]['body']
    previous = json.loads((DEPLOY / 'price-sources.json').read_text())
    prices = {m['id']: previous.get(m['id'], m['model']) for m in models}
    old_ids, new_ids = {m['id'] for m in old_models}, {m['id'] for m in models}
    print('Models removed from routing:', ', '.join(sorted(old_ids - new_ids)) or '(none)')
    print('Models added to routing:', ', '.join(sorted(new_ids - old_ids)) or '(none)')
    print('Historical usage and existing prices are retained, including removed models.')
    values = {DEPLOY / 'gateway/gateway.json': updated, STATE / 'providers.json': providers,
              DEPLOY / 'models.json': models, STATE / 'models.json': models,
              DEPLOY / 'price-sources.json': prices, STATE / 'prices.json': prices}
    return {path: (json.dumps(value, indent=2) + '\n').encode() for path, value in values.items()}


def migration_prices(models):
    """Insert missing alias prices without repricing historical events or policy."""
    statements = ['BEGIN;']
    for model in models:
        alias, source = model['id'], model['model']
        if any(not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}', v) for v in (alias, source)):
            raise ValueError('Invalid pricing alias/source')
        statements.append(f"""DO $guard$ BEGIN
IF NOT EXISTS (SELECT 1 FROM model_pricing WHERE model='{alias}') THEN
  IF NOT EXISTS (SELECT 1 FROM model_pricing WHERE model='{source}') THEN
    RAISE EXCEPTION 'Missing reviewed source price for {source}';
  END IF;
  IF EXISTS (SELECT 1 FROM usage_events WHERE model='{alias}') THEN
    RAISE EXCEPTION 'Refusing to reprice historical usage for {alias}';
  END IF;
END IF;
END $guard$;
INSERT INTO model_pricing(model,provider,input_cost_per_mtok,output_cost_per_mtok,
cache_write_cost_per_mtok,cache_read_cost_per_mtok,list_input_cost_per_mtok,
list_output_cost_per_mtok,list_cache_write_cost_per_mtok,list_cache_read_cost_per_mtok)
SELECT '{alias}',provider,input_cost_per_mtok,output_cost_per_mtok,
cache_write_cost_per_mtok,cache_read_cost_per_mtok,list_input_cost_per_mtok,
list_output_cost_per_mtok,list_cache_write_cost_per_mtok,list_cache_read_cost_per_mtok
FROM model_pricing WHERE model='{source}' ON CONFLICT(model) DO NOTHING;""")
    statements.append('COMMIT;')
    return '\n'.join(statements) + '\n'


def replacement_files(settings, name='pricetag', refresh=False):
    files = refresh_model_files(settings) if refresh else {}
    models = [m for m in json.loads((DEPLOY / 'models.json').read_text()) if m['provider'] == name]
    if not refresh:
        check_replacement_models(models, settings)
    else:
        models = settings['models']
    settings = copy.deepcopy(settings)
    settings['models'], settings['model'] = models, models[0]
    settings['prices'] = {m['id']: m['model'] for m in models}
    settings['price'] = models[0]['model']
    apis = {api for m in models for api in m['apis']}
    settings['urls'] = {api: url for api, url in settings['urls'].items() if api in apis}
    for path in (() if refresh else (DEPLOY / 'gateway/gateway.json', STATE / 'providers.json')):
        updated = replace_endpoints(json.loads(path.read_text()), settings['urls'], name=name)
        if name == 'pricetag' and 'anthropic' in settings['urls']:
            messages_auth(updated, settings.get('messages_auth', 'x-api-key'))
        files[path] = (json.dumps(updated, indent=2) + '\n').encode()
    uid = pwd.getpwnam('praxis-svc').pw_uid
    target = 'OPENAI_API_KEY' if name == 'openai' else 'CUSTOM_PRICETAG_API_KEY'
    for path in (DEPLOY / 'quadlets/pricetag-gateway.container',
                 USER_UNITS / str(uid) / 'pricetag-gateway.container',
                 STATE / 'provider-secrets.container'):
        lines = path.read_text().splitlines()
        matches = [i for i, line in enumerate(lines) if re.fullmatch(
            r'Secret=[A-Za-z0-9_.-]+,type=env,target=' + target, line)]
        if len(matches) != 1:
            raise ValueError('Expected one provider secret reference in ' + str(path))
        lines[matches[0]] = f'Secret={settings["secret"]},type=env,target={target}'
        files[path] = ('\n'.join(lines) + '\n').encode()
    files[STATE / ('provider-' + name + '.json')] = (json.dumps(settings, indent=2) + '\n').encode()
    return files


def relabel(paths):
    subprocess.run(['restorecon', *[str(path) for path in paths if str(path).startswith('/etc/')]],
                   check=True, capture_output=True)


def activate_gateway():
    service('systemctl', '--user', 'daemon-reload', check=True)
    service('systemctl', '--user', 'restart', 'pricetag-gateway.service', check=True)
    context = ssl.create_default_context(cafile=str(DEPLOY / 'ca.pem'))
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect(),
                                         urllib.request.HTTPSHandler(context=context))
    for _ in range(60):
        try:
            with opener.open('https://localhost:8443/login', timeout=2) as response:
                if response.status != 200:
                    raise ValueError('unexpected login status')
            try:
                opener.open('https://localhost:8443/v1/models', timeout=2).close()
            except urllib.error.HTTPError as error:
                status = error.code
                error.close()
                if status == 401:
                    return
            raise ValueError('unauthenticated inference catalog did not fail closed')
        except (urllib.error.URLError, OSError):
            time.sleep(.5)
    raise ValueError('gateway did not become healthy after replacement')


def install_replacement(files, price_sql=None):
    backup = Path(tempfile.mkdtemp(prefix='pricetag-replacement-', dir=STATE))
    originals, stats, manifest = {}, {}, []
    for index, path in enumerate(files):
        if path.is_symlink() or not path.is_file():
            raise ValueError('Expected regular configuration file: ' + str(path))
        originals[path], stats[path] = path.read_bytes(), path.stat()
        saved = backup / str(index)
        saved.write_bytes(originals[path]); saved.chmod(0o600)
        manifest.append({'target': str(path), 'backup': str(saved), 'uid': stats[path].st_uid,
                         'gid': stats[path].st_gid, 'mode': stats[path].st_mode & 0o777})
    (backup / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
    print('Private rollback backup:', backup)
    if price_sql:
        (backup / 'new-alias-prices.sql').write_text(price_sql)
        service('podman', 'exec', '-i', 'pricetag-db', 'psql', '-U', 'metering', '-d', 'metering',
                '-v', 'ON_ERROR_STOP=1', input=price_sql.encode(), check=True)
        print('Missing alias prices inserted; existing rates and usage unchanged.')

    def write(path, contents):
        with tempfile.NamedTemporaryFile(dir=path.parent, prefix='.replace-', delete=False) as output:
            temporary = Path(output.name)
            try:
                output.write(contents); output.flush(); os.fsync(output.fileno())
                os.fchown(output.fileno(), stats[path].st_uid, stats[path].st_gid)
                os.fchmod(output.fileno(), stats[path].st_mode & 0o777)
                os.replace(temporary, path)
            finally:
                temporary.unlink(missing_ok=True)
    try:
        for path, contents in files.items():
            write(path, contents)
        relabel(files)
        activate_gateway()
    except Exception:
        try:
            for path, contents in originals.items():
                write(path, contents)
            relabel(originals)
            activate_gateway()
        except Exception:
            raise ValueError('Replacement and automatic recovery failed; restore from ' + str(backup)) from None
        raise ValueError('Replacement failed; previous files and gateway restored. Backup: ' + str(backup)) from None
    print('Provider replacement active. Users, budgets, usage and existing prices preserved.')
    if price_sql:
        print('PriceTag routing/catalog refreshed. New alias prices remain available if configuration is rolled back.')
    print('Old Podman secrets retained for rollback. Verify a real inference request with your harness.')


def add_provider(name, urls=None, replace=False, check_auth=False, check_inference=None, refresh=False):
    if not sys.stdin.isatty():
        raise ValueError('Run interactively over SSH; never pipe provider keys')
    STATE.mkdir(mode=0o700, exist_ok=True)
    destination = STATE / ('provider-' + name + '.json')
    if destination.exists() and not replace and not (check_auth or check_inference):
        raise ValueError(name + ' is already configured; use --replace to update presets with a newly entered key')
    api = 'openai' if name == 'openai' else 'both'
    if name == 'openai':
        urls = {'openai': 'https://api.openai.com'}
    else:
        overrides = {api: url for api, url in (urls or {}).items() if url}
        if len(overrides) == 2:
            urls = overrides
        else:
            base = next(iter(overrides.values()), None) or prompt(
                'PriceTag host or URL (second hostname, https:// and /v1 are automatic)')
            urls = pricetag_urls(base)
            urls.update(overrides)
    urls = {dialect: normalize_url(address, dialect) for dialect, address in urls.items()}
    for dialect, address in urls.items():
        print('Credential destination:', dialect, address)
    url = next(iter(urls.values()))
    if len(urls) > 1:
        print('Use one PriceTag key authorized for both URLs.')
    key = getpass.getpass(name + ' provider key (hidden): ').strip()
    if not key or len(key) > 16384 or not re.fullmatch(r'[\x21-\x7e]+', key):
        raise ValueError('Expected one nonempty credential line')
    if check_auth:
        diagnose_catalog_auth(urls, key)
        return
    if check_inference:
        diagnose_inference(urls, key, check_inference)
        return
    settings = provider_settings(name, api, url, key, urls=urls)
    active = replace and (DEPLOY / 'bootstrap.done').is_file()
    files = replacement_files(settings, name=name, refresh=refresh) if active else None
    for model in settings.get('models', [settings['model']]):
        print('Ready:', model['id'], 'via', ', '.join(model.get('apis', [api])))
    result = service('podman', 'secret', 'create', settings['secret'], '-', input=key.encode())
    del key
    if result.returncode:
        raise ValueError('Podman secret creation failed; credential values are not shown')
    if active:
        install_replacement(files, price_sql=migration_prices(settings['models']) if refresh else None)
        return
    with tempfile.NamedTemporaryFile(mode='w', dir=STATE, prefix='.provider-', delete=False) as output:
        temporary = Path(output.name)
        json.dump(settings, output, indent=2)
    try:
        os.replace(temporary, destination)
    finally:
        temporary.unlink(missing_ok=True)
    print('Provider configured; key stored as a Podman secret')


def export():
    import yaml
    from provider_config import render
    from unified_config import validate
    entries = {}
    for name in ('openai', 'pricetag'):
        path = STATE / ('provider-' + name + '.json')
        if path.is_file():
            entries[name] = json.loads(path.read_text())
    if not entries:
        raise ValueError('Configure at least one provider before export')
    models = validate([model for entry in entries.values() for model in entry['models']])
    source = yaml.safe_load((ROOT / 'configs/all-in-one/shared-gateway.yaml').read_text())
    custom = {'pricetag': {api + '_url': url for api, url in entries['pricetag']['urls'].items()}} if 'pricetag' in entries else {}
    providers = render(source, vllm=False, openai='openai' in entries,
                       anthropic=False, custom=custom)
    if 'pricetag' in entries and 'anthropic' in entries['pricetag']['urls']:
        messages_auth(providers, entries['pricetag'].get('messages_auth', 'x-api-key'))
    prices, lines = {}, ['[Container]']
    for name, entry in entries.items():
        prices.update(entry['prices'])
        if service('podman', 'secret', 'exists', entry['secret']).returncode:
            raise ValueError('Required provider secret is missing')
        target = 'OPENAI_API_KEY' if name == 'openai' else 'CUSTOM_PRICETAG_API_KEY'
        lines.append(f'Secret={entry["secret"]},type=env,target={target}')
    for filename, data in [('providers.json', providers), ('models.json', models), ('prices.json', prices)]:
        (STATE / filename).write_text(json.dumps(data, indent=2) + '\n')
    (STATE / 'provider-secrets.container').write_text('\n'.join(lines) + '\n')
    print(f'Exported {len(models)} models and secret references to {STATE}; no services started')


def main():
    global DEBUG, ALLOW_UNVERIFIED_MODELS, CATALOG_AUTH, PINNED_MODELS, STATE, MESSAGES_AUTH
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=['openai', 'pricetag', 'export'])
    parser.add_argument('--openai-url', help='optional hosted PriceTag OpenAI endpoint override; HTTPS added if omitted')
    parser.add_argument('--anthropic-url', help='optional hosted PriceTag Messages endpoint override')
    parser.add_argument('--replace', action='store_true', help='replace saved inputs; on an active gateway, updates this provider endpoint/key with rollback and restarts only Praxis')
    parser.add_argument('--refresh-models', action='store_true',
                        help='with pricetag --replace: replace its routes/catalog with discovered presets plus explicit pins; retain historical pricing/usage')
    parser.add_argument('--state-dir', type=Path, default=STATE,
                        help='root-owned private provider input directory from initial setup')
    parser.add_argument('--debug', action='store_true', help='print request URLs, auth header names, HTTP status and model counts; no keys or response bodies')
    parser.add_argument('--allow-unverified-models', action='store_true',
                        help='PriceTag only: use unverified presets if initial model discovery returns 404/405/501; authentication/TLS failures still stop')
    parser.add_argument('--check-auth', action='store_true',
                        help='PriceTag only: probe both catalog headers; save no key and change no provider config')
    parser.add_argument('--check-inference', metavar='API:MODEL',
                        help='PriceTag only: test reviewed model with at most 16 output tokens; no configuration change')
    parser.add_argument('--messages-auth', choices=['x-api-key', 'bearer'], default='x-api-key',
                        help='PriceTag Messages credential header for discovery and inference')
    parser.add_argument('--catalog-auth', choices=['native', 'bearer', 'x-api-key'], default='native',
                        help='PriceTag model-discovery header only; inference keeps its native API header')
    parser.add_argument('--pin-model', action='append', default=[], metavar='API:MODEL',
                        help='PriceTag only: include a reviewed preset even if omitted from a successful catalog')
    args = parser.parse_args()
    if args.refresh_models and (args.command != 'pricetag' or not args.replace or args.check_auth or args.check_inference):
        parser.error('--refresh-models requires pricetag --replace without diagnostics')
    if args.check_auth and args.check_inference:
        parser.error('Choose one diagnostic: --check-auth or --check-inference')
    probe = None
    if args.check_inference:
        dialect, separator, model = args.check_inference.partition(':')
        if not separator or dialect not in PRESETS or model not in {row[0] for row in PRESETS[dialect]}:
            parser.error('--check-inference must name an API and a model in the reviewed presets')
        probe = (dialect, model)
    STATE = args.state_dir
    if not STATE.is_absolute() or '..' in STATE.parts:
        parser.error('--state-dir must be an absolute path without parent traversal')
    CATALOG_AUTH = args.catalog_auth
    MESSAGES_AUTH = args.messages_auth
    PINNED_MODELS = set()
    for value in args.pin_model:
        dialect, separator, model = value.partition(':')
        if not separator or dialect not in PRESETS or model not in {row[0] for row in PRESETS[dialect]}:
            parser.error('--pin-model must name an API and a model in the reviewed presets')
        PINNED_MODELS.add((dialect, model))
    if (PINNED_MODELS or CATALOG_AUTH != 'native' or MESSAGES_AUTH != 'x-api-key' or args.check_auth or probe) and args.command != 'pricetag':
        parser.error('discovery/header options are only supported for pricetag')
    ALLOW_UNVERIFIED_MODELS = args.allow_unverified_models
    if ALLOW_UNVERIFIED_MODELS and args.command != 'pricetag':
        parser.error('--allow-unverified-models is only supported for pricetag')
    DEBUG = args.debug
    check_host(allow_active=(args.command in ('openai', 'pricetag') and args.replace) or args.check_auth or bool(probe))
    os.umask(0o077)
    STATE.mkdir(mode=0o700, exist_ok=True)
    lock_fd = os.open(STATE / '.setup.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        raise ValueError('Another provider setup is already running') from None
    sys.path.insert(0, str(ROOT / 'scripts/common'))
    if args.command == 'export':
        export()
    else:
        urls = {}
        for api in ('openai', 'anthropic'):
            value = getattr(args, api + '_url')
            if value:
                urls[api] = value
        add_provider(args.command, urls=urls, replace=args.replace, check_auth=args.check_auth,
                     check_inference=probe, refresh=args.refresh_models)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        raise SystemExit('Setup stopped: ' + (str(error) if not isinstance(error, subprocess.CalledProcessError)
                                            else 'subprocess failed; no credential values printed')) from None
