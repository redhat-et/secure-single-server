#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: $0 --source DIR [--tag TAG] [--platform PLATFORM] [--expected-commit SHA]" >&2
  exit 2
}

source_dir=''
tag='localhost/pricetag-maas:standalone'
platform='linux/amd64'
expected_commit=''
while (($#)); do
  case "$1" in
    --source) (($# >= 2)) || usage; source_dir=$2; shift 2 ;;
    --tag) (($# >= 2)) || usage; tag=$2; shift 2 ;;
    --platform) (($# >= 2)) || usage; platform=$2; shift 2 ;;
    --expected-commit) (($# >= 2)) || usage; expected_commit=$2; shift 2 ;;
    *) usage ;;
  esac
done

[[ -n "$source_dir" && -d "$source_dir/maas-api" ]] || usage
command -v podman >/dev/null || { echo 'podman is required' >&2; exit 1; }
commit=$(git -C "$source_dir" rev-parse HEAD)
[[ "$commit" =~ ^[0-9a-f]{40}$ ]] || { echo 'source must be a Git checkout at a full commit' >&2; exit 1; }
if [[ -n "$expected_commit" && "$commit" != "$expected_commit" ]]; then
  echo "source commit $commit does not match expected commit $expected_commit" >&2
  exit 1
fi
if [[ ! -f "$source_dir/maas-api/Dockerfile" || ! -f "$source_dir/maas-api/go.mod" ]]; then
  echo 'source does not contain the MaaS API Dockerfile and Go module' >&2
  exit 1
fi

podman build --pull=always --platform "$platform" \
  --label "org.opencontainers.image.source=https://github.com/opendatahub-io/models-as-a-service" \
  --label "org.opencontainers.image.revision=$commit" \
  -t "$tag" -f "$source_dir/maas-api/Dockerfile" "$source_dir/maas-api"
podman image inspect "$tag" --format 'MaaS image {{.Id}} built from {{index .Labels "org.opencontainers.image.revision"}}'
