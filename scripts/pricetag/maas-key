#!/usr/bin/env python3
"""Create, inspect, rotate, or revoke a MaaS API key from the trusted host."""
import argparse
import json
import os
from pathlib import Path
import re
import ssl
import sys
import urllib.error
import urllib.parse
import urllib.request


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=('create', 'rotate', 'list', 'revoke'))
    parser.add_argument('--subject', required=True)
    parser.add_argument('--name', default='inference')
    parser.add_argument('--expires-in', default='90d')
    parser.add_argument('--admin', action='store_true', help='use the configured MaaS admin group')
    parser.add_argument('--admin-group', default='single-server-admin')
    parser.add_argument('--url', default='http://127.0.0.1:18086')
    parser.add_argument('--ca', type=Path)
    parser.add_argument('--output', type=Path)
    parser.add_argument('--key-id')
    args = parser.parse_args()

    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.@-]{0,127}', args.subject):
        parser.error('subject must be 1–128 letters, digits, dot, underscore, @ or hyphen')
    if args.command in ('create', 'rotate') and args.output is None:
        parser.error('create and rotate require --output')
    if args.command in ('create', 'rotate') and (args.output.exists() or args.output.is_symlink()):
        parser.error('output already exists; choose a new private path')
    if args.command == 'revoke' and not args.key_id:
        parser.error('revoke requires --key-id')
    if args.command == 'create' and not args.name.strip():
        parser.error('name must not be empty')
    if not re.fullmatch(r'([1-9][0-9]*)(d|h|m)', args.expires_in):
        parser.error('--expires-in must be a positive duration such as 90d or 12h')

    parsed = urllib.parse.urlsplit(args.url)
    if (parsed.scheme not in ('http', 'https') or not parsed.hostname or parsed.username
            or parsed.password or parsed.query or parsed.fragment or parsed.path not in ('', '/')):
        parser.error('--url must be an HTTP(S) origin without credentials, path, query, or fragment')
    if parsed.scheme != 'https' and parsed.hostname not in ('localhost', '127.0.0.1', '::1'):
        parser.error('plaintext MaaS access is allowed only over loopback')
    if args.ca and parsed.scheme != 'https':
        parser.error('--ca is valid only with HTTPS')

    group = ['system:authenticated']
    if args.admin:
        group.append(args.admin_group)
    headers = {'X-MaaS-Username': args.subject, 'X-MaaS-Group': json.dumps(group),
               'Accept': 'application/json', 'Content-Type': 'application/json'}
    tls = ssl.create_default_context(cafile=str(args.ca)) if args.ca else ssl.create_default_context()
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect(),
                                         urllib.request.HTTPSHandler(context=tls))

    def request(method, route, body=None):
        payload = None if body is None else json.dumps(body).encode()
        req = urllib.request.Request(args.url.rstrip('/') + route, data=payload,
                                     method=method, headers=headers)
        try:
            with opener.open(req, timeout=15) as response:
                return json.load(response)
        except urllib.error.HTTPError as error:
            # Do not print the response body; API errors can include request data.
            raise ValueError(f'MaaS returned HTTP {error.code} for {method} {route}') from None
        except (urllib.error.URLError, TimeoutError, OSError):
            raise ValueError('MaaS request failed; check loopback service readiness and TLS trust') from None

    if args.command == 'list':
        result = request('POST', '/v1/api-keys/search', {'filters': {'status': ['active']}})
        for item in result.get('data') or []:
            print(f"{item.get('id')}\t{item.get('name')}\t{item.get('status')}\t{item.get('expiresAt')}")
        return
    if args.command == 'revoke':
        request('DELETE', '/v1/api-keys/' + urllib.parse.quote(args.key_id, safe=''))
        print(f'Revoked key {args.key_id} for {args.subject}.')
        return

    previous = []
    if args.command == 'rotate':
        result = request('POST', '/v1/api-keys/search',
                         {'filters': {'status': ['active'], 'username': args.subject}})
        previous = [row.get('id') for row in (result.get('data') or [])
                    if row.get('name') == args.name and row.get('id')]

    result = request('POST', '/v1/api-keys',
                     {'name': args.name, 'expiresIn': args.expires_in})
    key = result.get('key')
    if not isinstance(key, str) or not key:
        raise ValueError('MaaS response omitted the one-time key; no credential file was written')
    args.output.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.umask(0o077)
    descriptor = os.open(args.output, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(descriptor, 'w') as output:
        output.write(key + '\n')
        output.flush()
        os.fsync(output.fileno())

    # Rotation creates and durably writes the replacement before revoking old IDs.
    # If revocation fails, report the new key path so the operator can recover safely.
    revoked = []
    if args.command == 'rotate':
        try:
            for key_id in previous:
                if key_id != result.get('id'):
                    request('DELETE', '/v1/api-keys/' + urllib.parse.quote(key_id, safe=''))
                    revoked.append(key_id)
        except ValueError as error:
            raise ValueError(f'{error}; replacement key is saved at {args.output}; revoke remaining prior keys manually') from None
    print(f"{args.command}d MaaS key for {args.subject}; expiry={result.get('expiresAt')}; saved at {args.output}.")
    if args.command == 'rotate':
        print(f'Revoked {len(revoked)} prior key(s) with the same name.')


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError) as error:
        sys.exit(str(error))
