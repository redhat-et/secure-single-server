#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
SOURCE="$ROOT/.docs-build"
MODE="${1:-serve}"

sync_docs() {
  rsync -a --delete \
    --exclude='/.git/' \
    --exclude='/.docs-build/' \
    --exclude='/.venv-docs/' \
    --exclude='/site/' \
    --exclude='/.state/' \
    --exclude='/evidence/' \
    --exclude='/.playwright-cli/' \
    --exclude='/.ruff_cache/' \
    --exclude='/mkdocs.yml' \
    "$ROOT/" "$SOURCE/"
}

sync_docs
if [[ "$MODE" == build ]]; then
  cd "$ROOT"
  .venv-docs/bin/mkdocs build --config-file mkdocs.yml
  exit
elif [[ "$MODE" != serve ]]; then
  printf 'Usage: %s [serve|build]\n' "${BASH_SOURCE[0]}" >&2
  exit 2
fi

while :; do
  sleep 1
  sync_docs
done &
SYNC_PID=$!
trap 'kill "$SYNC_PID" 2>/dev/null || true' EXIT INT TERM

cd "$ROOT"
.venv-docs/bin/mkdocs serve --config-file mkdocs.yml --dev-addr 127.0.0.1:8000
