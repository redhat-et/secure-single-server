#!/usr/bin/env bash
# NVIDIA 580 open driver + CDI on mutable RHEL, preserving DKMS for kernel updates.
set -euo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck source=scripts/common/lib.sh
source "${ROOT}/scripts/common/lib.sh"
require_root
[[ "$#" == 0 ]] || die 'usage: sudo scripts/vllm/prepare-gpu'
# shellcheck disable=SC1091
source /etc/os-release
[[ "${ID}" == rhel && "${VERSION_ID}" == 9.* && "$(uname -m)" == x86_64 ]] || die 'RHEL 9 x86_64 required'
[[ "$(getenforce)" == Enforcing ]] || die 'SELinux must remain enforcing'
curl -fsSL https://developer.download.nvidia.com/compute/cuda/repos/rhel9/x86_64/cuda-rhel9.repo \
  -o /etc/yum.repos.d/cuda-rhel9.repo
curl -fsSL https://nvidia.github.io/libnvidia-container/stable/rpm/nvidia-container-toolkit.repo \
  -o /etc/yum.repos.d/nvidia-container-toolkit.repo
epel_release=/tmp/epel-release-9-11.el9.noarch.rpm
curl -fsSL --retry 5 --retry-all-errors \
  https://download.fedoraproject.org/pub/epel/9/Everything/x86_64/Packages/e/epel-release-9-11.el9.noarch.rpm \
  -o "${epel_release}"
printf '%s  %s\n' \
  b434245bffd8b40ea486157e72363d08b36e38145c8f917c5c00adfca3f2101b \
  "${epel_release}" | sha256sum -c -
dnf install -y "${epel_release}"
rm -f "${epel_release}"
# The headers must match a kernel that will actually run. A fresh PAYG image can
# boot a kernel older than the RHUI repositories carry, so fall back to the
# matched meta package, which installs the newer kernel together with its
# headers; the reboot below boots that kernel.
if [[ -d "/lib/modules/$(uname -r)/build" ]]; then
  dnf install -y kernel-headers gcc make elfutils-libelf-devel dkms
elif dnf -q list available "kernel-devel-$(uname -r)" >/dev/null 2>&1; then
  dnf install -y "kernel-devel-$(uname -r)" kernel-headers gcc make elfutils-libelf-devel dkms
else
  note "kernel-devel for $(uname -r) is unavailable; installing the matched kernel and headers"
  dnf install -y kernel-devel-matched kernel-headers gcc make elfutils-libelf-devel dkms
fi
dnf module enable -y nvidia-driver:580-open
dnf install -y nvidia-driver-cuda kmod-nvidia-open-dkms nvidia-container-toolkit
# DKMS dependencies can install a newer kernel than the running one. Build
# every installed kernel with headers, including the one selected at reboot.
for build in /lib/modules/*/build; do
  [[ -d "${build}" ]] || continue
  kernel="${build%/build}"
  kernel="${kernel##*/}"
  dkms autoinstall -k "${kernel}"
  depmod -a "${kernel}"
done
printf 'nvidia\nnvidia_uvm\n' >/etc/modules-load.d/praxis-nvidia.conf
if modinfo -k "$(uname -r)" nvidia >/dev/null 2>&1; then
  modprobe nvidia
  modprobe nvidia_uvm
  systemctl restart nvidia-cdi-refresh.service
  nvidia-smi
  nvidia-ctk cdi list
else
  note "NVIDIA modules target a newer kernel; reboot before nvidia-smi or CDI checks."
fi
note 'NVIDIA driver and CDI installed. Reboot before final lifecycle qualification.'
