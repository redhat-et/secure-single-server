#!/usr/bin/env python3
"""Offline RS256 caller credentials and private-CA certificates for test VMs.

No third-party Python packages, network calls, shell expansion or secret output.
The JWT private key and lab CA key belong on the administrator workstation.
"""

import argparse
import base64
import ipaddress
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time
import uuid

ISSUER = "https://secure-single-server.local"
AUDIENCE = "praxis-gateway"


def openssl(*args, data=None):
    return subprocess.run(["openssl", *map(str, args)], input=data,
                          capture_output=True, check=True).stdout


def write_new(path, data):
    # O_EXCL refuses existing files and symlinks. umask is set before dispatch.
    with open(path, "xb") as output:
        output.write(data)


def encode(value):
    return base64.urlsafe_b64encode(value).rstrip(b"=")


def hostname(value):
    try:
        ipaddress.ip_address(value)
        return "IP:" + value
    except ValueError:
        if len(value) > 253 or not all(
            re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?", label)
            for label in value.split(".")
        ):
            raise ValueError("hostname must be a DNS name or IP address, without URL/port")
        return "DNS:" + value


def private_key(path):
    if path.is_symlink() or not path.is_file() or path.stat().st_mode & 0o077:
        raise ValueError("private key must be a regular, non-symlink file with mode 0600 or 0400")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    init = commands.add_parser("init-jwt", help="create a new issuer directory; never overwrite")
    init.add_argument("--directory", type=Path, required=True)
    issue = commands.add_parser("issue", help="write one expiring caller JWT, not a provider key")
    issue.add_argument("--key", type=Path, required=True)
    issue.add_argument("--subject", required=True)
    issue.add_argument("--output", type=Path, required=True)
    issue.add_argument("--days", type=int, default=30)
    lab = commands.add_parser("lab-tls", help="create a private test CA and server certificate")
    lab.add_argument("--directory", type=Path, required=True)
    lab.add_argument("--hostname", required=True)
    check = commands.add_parser("check-tls", help="check PEM key/certificate match and expiry")
    check.add_argument("--cert", type=Path, required=True)
    check.add_argument("--key", type=Path, required=True)
    args = parser.parse_args()
    os.umask(0o077)

    if args.command == "init-jwt":
        args.directory.mkdir(mode=0o700)
        key = args.directory / "private.pem"
        openssl("genpkey", "-algorithm", "RSA", "-pkeyopt", "rsa_keygen_bits:3072", "-out", key)
        write_new(args.directory / "public.pem", openssl("pkey", "-in", key, "-pubout"))
    elif args.command == "issue":
        private_key(args.key)
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.@-]{0,127}", args.subject):
            raise ValueError("subject must be 1-128 letters, digits, dot, underscore, @ or hyphen")
        if not 1 <= args.days <= 90:
            raise ValueError("days must be 1-90; expiry does not provide immediate revocation")
        now = int(time.time())
        claims = {"iss": ISSUER, "aud": AUDIENCE, "sub": args.subject,
                  "iat": now, "exp": now + args.days * 86400, "jti": str(uuid.uuid4())}
        message = encode(b'{"alg":"RS256","typ":"JWT"}') + b"." + encode(json.dumps(claims).encode())
        signature = openssl("dgst", "-sha256", "-sign", args.key, data=message)
        write_new(args.output, message + b"." + encode(signature) + b"\n")
    elif args.command == "lab-tls":
        san = hostname(args.hostname)
        directory = args.directory
        directory.mkdir(mode=0o700)
        ca_config = directory / "ca.cnf"
        write_new(ca_config, b"[req]\ndistinguished_name=dn\nx509_extensions=ca\nprompt=no\n"
                  b"[dn]\nCN=Praxis private test CA\n[ca]\nbasicConstraints=critical,CA:TRUE\n"
                  b"keyUsage=critical,keyCertSign,cRLSign\nsubjectKeyIdentifier=hash\n")
        openssl("req", "-x509", "-newkey", "rsa:3072", "-nodes", "-sha256", "-days", "90",
                "-keyout", directory / "ca-key.pem", "-out", directory / "ca.pem", "-config", ca_config)
        openssl("req", "-new", "-newkey", "rsa:3072", "-nodes", "-sha256",
                "-subj", "/CN=" + args.hostname, "-keyout", directory / "server-key.pem",
                "-out", directory / "server.csr")
        extension = directory / "server.cnf"
        write_new(extension, ("basicConstraints=critical,CA:FALSE\nkeyUsage=critical,digitalSignature,keyEncipherment\n"
                              "extendedKeyUsage=serverAuth\nsubjectKeyIdentifier=hash\n"
                              "authorityKeyIdentifier=keyid,issuer\nsubjectAltName=" + san + "\n").encode())
        openssl("x509", "-req", "-in", directory / "server.csr", "-CA", directory / "ca.pem",
                "-CAkey", directory / "ca-key.pem", "-CAcreateserial", "-days", "30", "-sha256",
                "-extfile", extension, "-out", directory / "server.pem")
    else:
        private_key(args.key)
        cert_public = openssl("x509", "-in", args.cert, "-pubkey", "-noout")
        key_public = openssl("pkey", "-in", args.key, "-pubout")
        if cert_public != key_public:
            raise ValueError("TLS certificate and private key do not match")
        try:
            openssl("x509", "-in", args.cert, "-checkend", "604800", "-noout")
        except subprocess.CalledProcessError as error:
            raise ValueError("TLS certificate must remain valid for at least seven days") from error
    print("Completed; no key or token values printed.")


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        # OpenSSL stderr can contain supplied material: do not print it.
        print("error: " + ("OpenSSL validation failed" if isinstance(error, subprocess.CalledProcessError)
                           else str(error)), file=sys.stderr)
        sys.exit(1)
