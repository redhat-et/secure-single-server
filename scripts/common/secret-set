#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
# shellcheck source=scripts/common/lib.sh
source "${SCRIPT_DIR}/lib.sh"

usage() {
  cat <<'EOF'
Usage:
  printf '%s' VALUE | sudo scripts/common/secret-set TYPE VERSION
  sudo scripts/common/secret-set valkey VERSION --generate

TYPE is openai, anthropic, judge, or valkey. Valkey creates both an ACL
secret and a connection-URL secret. VERSION must be a short immutable label
such as v1 or 2026-09-21.
EOF
}

[[ "$#" -ge 2 && "$#" -le 3 ]] || { usage >&2; exit 2; }
type="$1"
version="$2"
generate="${3:-}"

require_root
require_command openssl
require_command podman
require_command runuser
require_command sha256sum
service_uid >/dev/null
[[ "${version}" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ ]] || die "invalid secret version: ${version}"
if [[ -n "${generate}" && ( "${type}" != "valkey" || "${generate}" != "--generate" ) ]]; then
  die "--generate is supported only for a Valkey password"
fi

read_value() {
  local value=""
  if [[ "${generate}" == "--generate" ]]; then
    value="$(openssl rand -hex 32)"
  else
    [[ -z "${generate}" ]] || die "unknown option: ${generate}"
    IFS= read -r value || true
  fi
  [[ -n "${value}" ]] || die "secret value must not be empty"
  printf '%s' "${value}"
}

create_secret() {
  local name="$1" value="$2"
  validate_secret_name "${name}"
  secret_exists "${name}" && die "secret already exists; use a new version: ${name}"
  printf '%s' "${value}" | as_service podman secret create "${name}" - >/dev/null
}

case "${type}" in
  openai|anthropic|judge)
    value="$(read_value)"
    name="praxis-${type}-api-key-${version}"
    create_secret "${name}" "${value}"
    unset value
    note "created ${name}"
    ;;
  valkey)
    password="$(read_value)"
    [[ "${password}" =~ ^[A-Za-z0-9._~-]+$ ]] ||
      die "Valkey password must be URL-safe (A-Z, a-z, 0-9, dot, underscore, tilde, hyphen)"
    password_hash="$(printf '%s' "${password}" | sha256sum | awk '{print $1}')"
    acl_name="praxis-valkey-acl-${version}"
    url_name="praxis-valkey-url-${version}"
    secret_exists "${acl_name}" && die "secret already exists; use a new version: ${acl_name}"
    secret_exists "${url_name}" && die "secret already exists; use a new version: ${url_name}"
    acl="$(valkey_acl "${password_hash}")"
    create_secret "${acl_name}" "${acl}"
    if ! create_secret "${url_name}" "redis://praxis:${password}@praxis-valkey:6379/0"; then
      as_service podman secret rm "${acl_name}" >/dev/null 2>&1 || true
      die "could not create ${url_name}; removed partial secret ${acl_name}"
    fi
    unset password password_hash acl
    note "created ${acl_name}"
    note "created ${url_name}"
    ;;
  *) usage >&2; die "unsupported secret type: ${type}" ;;
esac
