#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
# shellcheck source=scripts/common/lib.sh
source "${SCRIPT_DIR}/lib.sh"

purge_valkey_data=0
if [[ "${1:-}" == "--purge-valkey-data" ]]; then
  purge_valkey_data=1
  shift
fi
[[ "$#" -eq 0 ]] || die "usage: sudo scripts/common/uninstall [--purge-valkey-data]"

require_root
for command in podman runuser semanage systemctl; do
  require_command "${command}"
done
verify_managed_manifest

as_service systemctl --user stop praxis.service 2>/dev/null || true
as_service systemctl --user stop praxis-valkey.service 2>/dev/null || true
as_service systemctl --user stop praxis-network.service 2>/dev/null || true
as_service systemctl --user stop praxis-valkey-volume.service 2>/dev/null || true
as_service podman network rm praxis-private >/dev/null 2>&1 || true

while read -r _ path; do
  validate_owned_path "${path}"
  case "${path}" in
    "${CONFIG_DIR}/shared-gateway.yaml"|"${CONFIG_DIR}/valkey.conf"|"${CONFIG_DIR}/policy.yaml"|"${CONFIG_DIR}/jwt-public.pem"|"${CONFIG_DIR}/tls.pem"|"${CONFIG_DIR}/tls-key.pem")
      semanage fcontext -d "$(selinux_path_regex "${path}")" >/dev/null 2>&1 || true
      ;;
  esac
  rm -f -- "${path}"
done <"${MANIFEST_FILE}"
rm -f -- "${MANIFEST_FILE}"

as_service systemctl --user daemon-reload
if (( purge_valkey_data == 1 )); then
  as_service podman volume rm praxis-valkey-data >/dev/null 2>&1 || true
  note "removed the shared-gateway Valkey data volume"
else
  note "preserved Podman secrets and the shared-gateway Valkey data volume"
fi
note "removed managed shared-gateway files; preserved ${SERVICE_USER} and its linger setting"
