#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
# shellcheck source=scripts/common/lib.sh
source "${SCRIPT_DIR}/lib.sh"

require_root
verify_managed_manifest

backup_root="${CONFIG_DIR}/rollback"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
backup_dir="${backup_root}/${timestamp}"
install -d -o root -g root -m 0700 "${backup_root}" "${backup_dir}"

while read -r _ path; do
  validate_owned_path "${path}"
  relative="${path#/}"
  install -d -o root -g root -m 0700 "${backup_dir}/$(dirname -- "${relative}")"
  cp --preserve=mode,ownership,timestamps "${path}" "${backup_dir}/${relative}"
done <"${MANIFEST_FILE}"
cp --preserve=mode,ownership,timestamps "${MANIFEST_FILE}" "${backup_dir}/shared-gateway.manifest"

printf 'saved rollback files in %s\n' "${backup_dir}"
scenario="all-in-one"
[[ ! -f "${SCENARIO_FILE}" ]] || scenario="$(<"${SCENARIO_FILE}")"
exec "${SCRIPT_DIR}/install" --scenario "${scenario}" --replace "$@"
